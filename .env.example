# Discord Bot のトークン（必須）
# https://discord.com/developers/applications で Bot を作成して取得する
DISCORD_TOKEN=

# 開発用ギルドID（任意）。
# 設定するとスラッシュコマンドをそのギルドへ即時同期する。
# 未設定ならグローバル同期（反映まで最大1時間）。
DEV_GUILD_ID=

# パネル見出しなどに表示する名前（任意）。未設定なら「今ヒマ！」。
BOT_DISPLAY_NAME=

# Atsumaro API（Bot が接続する先）
API_BASE_URL=http://127.0.0.1:8000
# API 側の api/.env と同じ値を設定すること
BOT_API_SECRET=
