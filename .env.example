# Discord Bot のトークン（必須）
# https://discord.com/developers/applications で Bot を作成して取得する
DISCORD_TOKEN=

# 開発用ギルドID（任意）。
# 設定するとスラッシュコマンドをそのギルドへ即時同期する。
# 未設定ならグローバル同期（反映まで最大1時間）。
DEV_GUILD_ID=

# パネル見出しなどに表示する名前（任意）。未設定なら「今ヒマ！」。
BOT_DISPLAY_NAME=

# Atsumaro API（Bot が接続する先）
API_BASE_URL=http://127.0.0.1:8000
# API 側の api/.env と同じ値を設定すること
BOT_API_SECRET=

# --- アプリ用（Atsumaro API 側の api/.env に設定する）---

# Discord OAuth アプリのクライアント情報
# https://discord.com/developers/applications の OAuth2 設定で取得する
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# JWT 署名シークレット（未設定なら開発用デフォルト値を使う）
API_JWT_SECRET=

# FCM プッシュのサービスアカウント JSON のファイルパス（任意）。
# 未設定なら dry-run（ログのみ）で動作する（ハッカソン期間の既定）
FCM_SERVICE_ACCOUNT_JSON=
