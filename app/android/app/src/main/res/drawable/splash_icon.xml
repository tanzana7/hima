<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ launch screen icon (`windowSplashScreenAnimatedIcon`): the app
  icon artwork.

  The system scales this drawable into a 288dp box and masks it to a 192dp
  circle, so drawable-nodpi/splash_art.png keeps the paint inside the middle
  58% of its square instead of letting the circle crop the blobs' arms.
-->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/splash_art"
    android:filter="true" />
