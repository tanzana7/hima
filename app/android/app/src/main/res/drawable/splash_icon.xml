<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ launch screen icon (`windowSplashScreenAnimatedIcon`).

  The system draws this drawable in a 288dp box and masks it to a 192dp circle,
  so the mark is scaled to 2/3 of its size in splash_logo.xml to stay inside
  that circle instead of being cropped.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <path
        android:fillColor="#FF6389"
        android:pathData="M232,0 L792,0 A232,232 0 0,1 1024,232 L1024,792 A232,232 0 0,1 792,1024 L232,1024 A232,232 0 0,1 0,792 L0,232 A232,232 0 0,1 232,0 Z" />

    <group
        android:pivotX="512"
        android:pivotY="512"
        android:scaleX="0.7667"
        android:scaleY="0.7667">
        <path
            android:pathData="M291,300 L291,720"
            android:strokeColor="#2F124F"
            android:strokeWidth="96"
            android:strokeLineCap="round" />
        <path
            android:pathData="M291,540 C291,462 341,420 441,420 C541,420 591,462 591,528 L591,720"
            android:strokeColor="#2F124F"
            android:strokeWidth="96"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:fillColor="#FFE65A"
            android:pathData="M723,662 m-58,0 a58,58 0 1,1 116,0 a58,58 0 1,1 -116,0" />
    </group>
</vector>
